load("@stardoc//stardoc:stardoc.bzl", "stardoc")

package(default_visibility = ["//visibility:private"])

bzl_library(
    name = "docs_deps",
    srcs = [
        "@bazel_tools//tools:bzl_srcs",
    ],
    deps = [
        "@apple_support//lib:apple_support",
        "@bazel_skylib//lib:paths",
        "@bazel_skylib//lib:selects",
        "@bazel_skylib//lib:structs",
        "@bazel_skylib//rules:common_settings",
    ],
)

bzl_library(
    name = "all_docs",
    deps = [
        ":docs_deps",
        "@rules_rust//cargo:bzl_lib",
        "@rules_rust//crate_universe:bzl_lib",
        "@rules_rust//rust:bzl_lib",
        "@rules_rust_bindgen//:bzl_lib",
        "@rules_rust_prost//:bzl_lib",
        "@rules_rust_wasm_bindgen//:bzl_lib",
    ],
)

stardoc(
    name = "cargo_build_script",
    out = "src/cargo_build_script.md",
    input = "@rules_rust//cargo:cargo_build_script.bzl",
    symbol_names = ["cargo_build_script"],
    deps = [":all_docs"],
)

