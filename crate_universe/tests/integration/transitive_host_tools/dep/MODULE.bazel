module(
    name = "cu_test_transitive_host_tools_dep",
    version = "0.0.0",
)

bazel_dep(name = "rules_rust", version = "0.0.0")
local_path_override(
    module_name = "rules_rust",
    path = "../../../../..",
)

no_host_tools = use_repo_rule("//:no_host_tools.bzl", "no_host_tools")

no_host_tools(name = "no_host_tools")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.spec(
    package = "cfg-if",
    repositories = ["transitive_host_tools_dep"],
    version = "1.0.0",
)
crate.from_specs(
    name = "transitive_host_tools_dep",
    cargo_lockfile = "//:Cargo.Bazel.lock",
    # As a dependency this module renders from `lockfile` and needs neither
    # cargo nor rustc. To repin, remove this attribute and run
    # `CARGO_BAZEL_REPIN=true bazel fetch --lockfile_mode=off @transitive_host_tools_dep//...`
    # from this directory.
    host_tools = "@no_host_tools",
    lockfile = "//:cargo-bazel-lock.json",
)
use_repo(
    crate,
    "transitive_host_tools_dep",
)
