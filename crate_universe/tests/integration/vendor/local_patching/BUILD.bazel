load("@rules_rust//crate_universe:defs.bzl", "crates_vendor")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load("//local_patching/vendor:crates.bzl", "crate_deps")

crates_vendor(
    name = "crates_vendor",
    cargo_lockfile = ":Cargo.lock",
    manifests = [":Cargo.toml"],
    mode = "local",
    # No wasi support
    supported_platform_triples = [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-fuchsia",
        "aarch64-unknown-fuchsia",
    ],
    vendor_path = "vendor",
)

rust_binary(
    name = "bin",
    srcs = ["src/main.rs"],
    edition = "2021",
    deps = ["//local_patching/vendor:getrandom"] + crate_deps(["rand"]),
)

rust_test(
    name = "test",
    crate = ":bin",
)

rust_test(
    name = "crate_deps_test",
    srcs = ["src/getrandom_test.rs"],
    edition = "2021",
    deps = crate_deps(["getrandom"]),
)
