load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@cui//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_doc", "rust_doc_test", "rust_library", "rust_test")
load("//crate_universe:version.bzl", "VERSION")
load("//crate_universe/private:bootstrap_utils.bzl", "source_installer")
load(
    "//rust/platform:triple_mappings.bzl",
    "SUPPORTED_PLATFORM_TRIPLES",
    "SUPPORTED_PLATFORM_TRIPLES_WITH_HOST_TOOLS",
)

exports_files(
    glob([
        "src/**/*.bzl",
        "src/**/*.j2",
        "src/**/*.rs",
    ]) + [
        "Cargo.toml",
        "Cargo.lock",
        "defs.bzl",
        "extensions.bzl",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bzl_srcs",
    srcs = glob(["*.bzl"]) + [
        "//crate_universe/3rdparty:bzl_srcs",
        "//crate_universe/private:bzl_srcs",
        "//crate_universe/tools:bzl_srcs",
    ],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "bzl_lib",
    srcs = [":bzl_srcs"],
    visibility = ["//visibility:public"],
    deps = [
        "//rust:bzl_lib",
        "@bazel_features//:features",
    ],
)

filegroup(
    name = "rust_data",
    srcs = glob([
        "src/**/*.bzl",
        "src/**/*.bat",
        "src/**/*.j2",
        "src/**/*.json",
        "src/**/*.sh",
    ]) + [
        # The SPDX license kinds `cargo-bazel` may name, see `src/rendering.rs`.
        "//crate_universe/private/spdx:kinds.bzl",
    ],
)

# `rustc --print=cfg` of every supported platform, recorded from the registered
# toolchain so resolution does not depend on the rustc at hand. The diff test
# fails when a toolchain update changes the output; run the installer to update.
genrule(
    name = "rustc_cfgs_generated",
    outs = ["rustc_cfgs.generated.json"],
    cmd = "$(execpath :cargo_bazel_bin) rustc-cfgs --rustc $(RUSTC) --triples {} --output $@".format(",".join(SUPPORTED_PLATFORM_TRIPLES)),
    cmd_bat = "$(execpath :cargo_bazel_bin) rustc-cfgs --rustc $(RUSTC) --triples {} --output $@".format(",".join(SUPPORTED_PLATFORM_TRIPLES)),
    toolchains = ["//rust/toolchain:current_rust_toolchain"],
    tools = [
        ":cargo_bazel_bin",
        "//rust/toolchain:current_rust_toolchain",
    ],
)

diff_test(
    name = "rustc_cfgs_diff_test",
    failure_message = "The recorded `rustc --print=cfg` table is out of date. Run `bazel run //crate_universe:rustc_cfgs.install`.",
    file1 = "src/metadata/rustc_cfgs.json",
    file2 = ":rustc_cfgs_generated",
    # The table records stable's cfgs; nightly prints its unstable ones as well.
    target_compatible_with = select({
        "//rust/toolchain/channel:stable": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

source_installer(
    name = "rustc_cfgs.install",
    dest = "src/metadata/rustc_cfgs.json",
    input = ":rustc_cfgs_generated",
)

filegroup(
    name = "rust_srcs",
    srcs = glob([
        "src/**/*.rs",
    ]) + [
        ":rust_data",
    ],
    visibility = ["//crate_universe:__subpackages__"],
)

MSVC_RUSTC_FLAGS = [
    "-Ctarget-feature=+crt-static",
]

# Passed to tests through `rustc_env_files` so the triple lists, which grow with
# every platform `rules_rust` adds, need not fit in the environment of the
# `rustc` action.
write_file(
    name = "platform_triples_env",
    out = "platform_triples.env",
    content = [
        "SUPPORTED_PLATFORM_TRIPLES=" + ",".join(SUPPORTED_PLATFORM_TRIPLES),
        "SUPPORTED_PLATFORM_TRIPLES_WITH_HOST_TOOLS=" + ",".join(SUPPORTED_PLATFORM_TRIPLES_WITH_HOST_TOOLS),
    ],
)

rust_library(
    name = "cargo_bazel",
    srcs = glob(
        include = ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    aliases = aliases(),
    compile_data = [":rust_data"],
    edition = "2021",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_flags = select({
        "//rust/platform:aarch64-pc-windows-msvc": MSVC_RUSTC_FLAGS,
        "//rust/platform:i686-pc-windows-msvc": MSVC_RUSTC_FLAGS,
        "//rust/platform:x86_64-pc-windows-msvc": MSVC_RUSTC_FLAGS,
        "//conditions:default": [],
    }),
    # This target embeds additional, stamping related information (see
    # https://docs.bazel.build/versions/main/user-manual.html#workspace_status
    # for more information). Set stamp = -1 to indicate that it should respect
    # the value of the --stamp commandline flag.
    stamp = -1,
    version = VERSION,
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

rust_binary(
    name = "cargo_bazel_bin",
    srcs = ["src/main.rs"],
    edition = "2021",
    version = VERSION,
    visibility = ["//visibility:public"],
    deps = [":cargo_bazel"],
)

alias(
    name = "bin",
    actual = ":cargo_bazel_bin",
    visibility = ["//visibility:public"],
)

rust_test(
    name = "unit_test",
    aliases = aliases(),
    compile_data = glob(["test_data/**"]),
    crate = ":cargo_bazel",
    data = glob(["test_data/**"]) + [
        "//crate_universe/test_data/serialized_configs",
        "@rules_rust//cargo:current_cargo_toolchain",
        "@rules_rust//rust/toolchain:current_rustc_files",
    ],
    proc_macro_deps = all_crate_deps(
        proc_macro_dev = True,
    ),
    rustc_env = {
        "CARGO": "$(rootpath @rules_rust//cargo:current_cargo_toolchain)",
        "RUSTC": "$(rootpath @rules_rust//rust/toolchain:current_rustc_files)",
    },
    # Passed through so `RUSTC_TRIPLES_WITH_HOST_TOOLS` is checked against the
    # `host_tools` bits `rules_rust` tracks.
    rustc_env_files = [":platform_triples_env"],
    # TODO: `crate_universe` currently does not work on Windows.
    # https://github.com/bazelbuild/rules_rust/issues/1156
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        "@rules_rust//rust/runfiles",
    ] + all_crate_deps(
        normal_dev = True,
    ),
)

# Integration tests which invoke cargo and/or rustc as subprocesses.
rust_test(
    name = "cargo_integration_test",
    timeout = "long",
    srcs = ["tests/cargo_integration_test.rs"],
    aliases = aliases(),
    data = glob(["test_data/**"]) + [
        "@rules_rust//cargo:current_cargo_toolchain",
        "@rules_rust//rust/toolchain:current_rustc_files",
    ],
    edition = "2021",
    env = {
        "CARGO": "$(rlocationpath @rules_rust//cargo:current_cargo_toolchain)",
        "RUSTC": "$(rlocationpath @rules_rust//rust/toolchain:current_rustc_files)",
    },
    proc_macro_deps = all_crate_deps(
        proc_macro_dev = True,
    ),
    # Passed through so the test covers exactly the platforms `rules_rust`
    # supports.
    rustc_env_files = [":platform_triples_env"],
    tags = ["requires-network"],
    # TODO: `crate_universe` currently does not work on Windows.
    # https://github.com/bazelbuild/rules_rust/issues/1156
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        ":cargo_bazel",
        "@rules_rust//rust/runfiles",
    ] + all_crate_deps(
        normal = True,
    ),
)

rust_test(
    name = "versions_test",
    srcs = ["tests/version_test.rs"],
    data = [
        "Cargo.toml",
        "version.bzl",
    ],
    edition = "2021",
    rustc_env = {
        "CARGO_TOML": "$(rlocationpath :Cargo.toml)",
        "VERSION_BZL": "$(rlocationpath :version.bzl)",
    },
    deps = ["//rust/runfiles"],
)

rust_doc(
    name = "rustdoc",
    crate = ":cargo_bazel",
    rustdoc_flags = [
        "--cap-lints=warn",
        "--document-private-items",
        "--allow=rustdoc::private_intra_doc_links",
    ],
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "rustdoc_test",
    crate = ":cargo_bazel",
    # TODO: `rust_doc_test` currently does not work on Windows.
    # https://github.com/bazelbuild/rules_rust/issues/1156
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)
