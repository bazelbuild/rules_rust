module(name = "prost_without_rustfmt")

bazel_dep(name = "rules_rust", version = "0.0.0")
local_path_override(
    module_name = "rules_rust",
    path = "../../..",
)

bazel_dep(name = "rules_rust_prost", version = "0.0.0")
local_path_override(
    module_name = "rules_rust_prost",
    path = "../../../extensions/prost",
)

bazel_dep(name = "rules_proto", version = "7.1.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    # rules_rust registers every toolchain of the hub, so the only way to
    # leave the execution platform without a `rustfmt_toolchain` is to
    # register rustfmt for a platform no host of this test is.
    rustfmt_toolchain_triples = {
        "s390x-unknown-linux-gnu": "rustfmt_linux_s390x",
    },
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")
