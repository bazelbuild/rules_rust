load("@bazel_skylib//rules:build_test.bzl", "build_test")
load(":toolchain_test.bzl", "toolchain_test_suite")

toolchain_test_suite(name = "toolchain_test_suite")

genrule(
    name = "inspect",
    outs = ["rustc-cfg"],
    # rustc assumes it can read things like librustc_driver in order to run this command.
    # This is a test to ensure we supply all of the files rustc needs as part of the current_rust_toolchain.
    cmd = "$(RUSTC) --print=cfg > $@",
    cmd_bat = "$(RUSTC) --print=cfg > $@",
    toolchains = ["@rules_rust//rust/toolchain:current_rust_toolchain"],
    tools = ["@rules_rust//rust/toolchain:current_rust_toolchain"],
)

build_test(
    name = "inspect_build_test",
    targets = [":inspect"],
)

genrule(
    name = "cargo_version",
    outs = ["cargo-version"],
    # `current_cargo_toolchain` is a `cargo_toolchain_alias`: it supplies the
    # `$(CARGO)` Make variable and the binary as a tool.
    cmd = "$(CARGO) --version > $@",
    cmd_bat = "$(CARGO) --version > $@",
    toolchains = ["@rules_rust//cargo:current_cargo_toolchain"],
    tools = ["@rules_rust//cargo:current_cargo_toolchain"],
)

build_test(
    name = "cargo_version_build_test",
    targets = [":cargo_version"],
)

genrule(
    name = "rustdoc_version",
    outs = ["rustdoc-version"],
    # `current_rustdoc_toolchain` is a `rustdoc_toolchain_alias`: it supplies
    # the `$(RUSTDOC)` Make variable and the binary with the `librustc_driver`
    # libraries it loads at run time.
    cmd = "$(RUSTDOC) --version > $@",
    cmd_bat = "$(RUSTDOC) --version > $@",
    toolchains = ["@rules_rust//rust/toolchain:current_rustdoc_toolchain"],
    tools = ["@rules_rust//rust/toolchain:current_rustdoc_toolchain"],
)

build_test(
    name = "rustdoc_version_build_test",
    targets = [":rustdoc_version"],
)

genrule(
    name = "clippy_version",
    outs = ["clippy-version"],
    # Likewise for `current_clippy_toolchain` and `$(CLIPPY_DRIVER)`.
    cmd = "$(CLIPPY_DRIVER) --version > $@",
    cmd_bat = "$(CLIPPY_DRIVER) --version > $@",
    toolchains = ["@rules_rust//rust/toolchain:current_clippy_toolchain"],
    tools = ["@rules_rust//rust/toolchain:current_clippy_toolchain"],
)

build_test(
    name = "clippy_version_build_test",
    targets = [":clippy_version"],
)
