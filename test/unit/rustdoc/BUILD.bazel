load(":rustdoc_unit_test.bzl", "rustdoc_test_suite")

rustdoc_test_suite(
    name = "rustdoc_test_suite",
)

# Distinct platforms exercise test helpers without executing foreign binaries.
platform(
    name = "macos_aarch64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:macos",
    ],
)

platform(
    name = "macos_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:macos",
    ],
)

config_setting(
    name = "compiled_doctests",
    flag_values = {
        "//rust/settings:experimental_compile_rustdoc_tests": "true",
        "//rust/toolchain/channel:channel": "nightly",
    },
)
