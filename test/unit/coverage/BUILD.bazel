load("@bazel_features//:features.bzl", "bazel_features")
load("//rust:defs.bzl", "rust_binary", "rust_test")
load(
    ":coverage_test.bzl",
    "collector_platform_test",
    "collector_probe",
    "coverage_collector_flag_test",
    "coverage_collector_metadata_files_test",
    "coverage_collector_runfiles_test",
    "platform_marker",
)

collector_platform_test(
    name = "collector_platform_test",
    target_under_test = ":collector",
)

collector_probe(
    name = "collector",
    testonly = True,
    dep = ":test",
    # Older Bazel versions run tests on the first execution platform.
    exec_compatible_with = [":tester" if bazel_features.toolchains.has_default_test_toolchain_type else ":compiler"],
    marker = ":marker",
    tags = ["manual"],
    target_compatible_with = [":tester"],
)

platform_marker(name = "marker")

rust_test(
    name = "test",
    srcs = ["test.rs"],
    edition = "2021",
)

rust_binary(
    name = "fake_collector",
    srcs = ["fake_collector.rs"],
    data = ["fake_collector_data.txt"],
    edition = "2021",
)

coverage_collector_flag_test(
    name = "coverage_collector_flag_test",
    target_under_test = ":test",
)

coverage_collector_metadata_files_test(
    name = "coverage_collector_metadata_files_test",
    target_under_test = ":test",
)

coverage_collector_runfiles_test(
    name = "coverage_collector_runfiles_test",
    target_under_test = ":test",
)

constraint_setting(name = "execution_role")

constraint_value(
    name = "compiler",
    constraint_setting = ":execution_role",
)

constraint_value(
    name = "tester",
    constraint_setting = ":execution_role",
)

platform(
    name = "compiler_platform",
    constraint_values = [":compiler"],
    parents = ["@platforms//host"],
)

platform(
    name = "test_platform",
    constraint_values = [":tester"],
    parents = ["@platforms//host"],
)
