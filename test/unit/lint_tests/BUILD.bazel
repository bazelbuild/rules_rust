load(":lint_tests.bzl", "lint_tests_suite")

lint_tests_suite(name = "lint_tests_suite")

# Distinct platforms exercise test helpers without executing foreign binaries.
platform(
    name = "macos_aarch64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:macos",
    ],
)

platform(
    name = "macos_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:macos",
    ],
)
