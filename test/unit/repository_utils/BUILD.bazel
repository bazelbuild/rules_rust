load(":llvm_tools_test.bzl", "llvm_runtime_libraries_test")
load(":repository_utils_test.bzl", "repository_utils_test_suite")

############################ UNIT TESTS #############################
repository_utils_test_suite(name = "repository_utils_test_suite")

llvm_runtime_libraries_test(
    name = "macos_llvm_runtime",
    expected = [
        "libLLVM.dylib",
        "libLLVM-23.dylib",
    ],
    library = "@llvm_macos_fixture//:llvm_lib",
)

llvm_runtime_libraries_test(
    name = "linux_llvm_runtime",
    expected = [
        "libLLVM.so",
        "libLLVM.so.23",
    ],
    library = "@llvm_linux_fixture//:llvm_lib",
)

llvm_runtime_libraries_test(
    name = "static_llvm_runtime",
    expected = [],
    library = "@llvm_static_fixture//:llvm_lib",
)
