load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")
load("@rules_cc//cc:defs.bzl", "cc_import", "cc_library")
load("//rust:defs.bzl", "rust_doc_test", "rust_library")
load(":runfiles_test.bzl", "compiled_runfiles_test", "without_runfiles")

# Compiled doctest launchers do not yet keep their executable suffix on Windows.
NOT_WINDOWS = select({
    "@platforms//os:windows": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

rust_doc_test(
    name = "runtime_data_test",
    crate = ":lib",
    rustdoc_flags = ["--test-args=--nocapture"],
    target_compatible_with = NOT_WINDOWS + select({
        ":compiled_doctests": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":extra",
        ":native_without_runfiles",
    ],
)

compiled_runfiles_test(
    name = "compiled_runfiles_test",
    target_compatible_with = NOT_WINDOWS + select({
        ":compiled_doctests": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    target_under_test = ":runtime_data_test",
)

rust_library(
    name = "lib",
    srcs = ["lib.rs"],
    compile_data = ["compile.txt"],
    crate_name = "doctest_runfiles",
    data = ["crate.txt"],
    edition = "2021",
    link_deps = [":native_import"],
    target_compatible_with = NOT_WINDOWS,
    deps = [":transitive"],
)

rust_library(
    name = "transitive",
    srcs = ["empty.rs"],
    data = ["transitive.txt"],
    edition = "2021",
)

rust_library(
    name = "extra",
    srcs = ["empty.rs"],
    data = ["extra.txt"],
    edition = "2021",
)

cc_import(
    name = "native_import",
    shared_library = ":native_shared",
    target_compatible_with = NOT_WINDOWS,
)

without_runfiles(
    name = "native_without_runfiles",
    dep = ":native_import",
)

cc_shared_library(
    name = "native_shared",
    target_compatible_with = NOT_WINDOWS,
    # Use the declared runtime path so this tests runfiles propagation without
    # depending on rustdoc's executable-relative rpaths for persisted tests.
    user_link_flags = select({
        "@platforms//os:linux": ["-Wl,-soname,test/rustdoc_runfiles/libnative_shared.so"],
        "@platforms//os:macos": ["-Wl,-install_name,test/rustdoc_runfiles/libnative_shared.dylib"],
        "//conditions:default": [],
    }),
    deps = [":native"],
)

cc_library(
    name = "native",
    srcs = ["native.c"],
    target_compatible_with = NOT_WINDOWS,
)

config_setting(
    name = "compiled_doctests",
    flag_values = {
        "//rust/settings:experimental_compile_rustdoc_tests": "true",
        "//rust/toolchain/channel:channel": "nightly",
    },
)
