load("@bazel_skylib//rules:build_test.bzl", "build_test")

# A `toolchain_type` in `toolchains` resolves to the registered
# `rust_prost_toolchain`, whose Make variables expand here.
genrule(
    name = "make_variables",
    outs = ["make_variables.txt"],
    cmd = """\
echo 'PROST_PLUGIN=$(PROST_PLUGIN)' >> $@
echo 'PROST_PLUGIN_RLOCATIONPATH=$(PROST_PLUGIN_RLOCATIONPATH)' >> $@
echo 'TONIC_PLUGIN=$(TONIC_PLUGIN)' >> $@
echo 'TONIC_PLUGIN_RLOCATIONPATH=$(TONIC_PLUGIN_RLOCATIONPATH)' >> $@
""",
    toolchains = ["//:toolchain_type"],
)

build_test(
    name = "make_variables_test",
    targets = [":make_variables"],
)
